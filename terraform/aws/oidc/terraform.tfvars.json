{
    "clusters": {
        "dev": {
            "metal_dev_role": {
                "sub": "system:serviceaccount:external-secrets:external-secrets",
                "ssm_paths": [
                    "/clusters/config",
                    "/clusters/dev/*",
                    "/clusters/pgsql/dev/*"
                ]
            },
            "metal_dev_pgsql_role": {
                "sub": "system:serviceaccount:postgresql-admin:postgresql-admin",
                "ssm_paths": [
                    "/clusters/pgsql/*"
                ]
            }
        }
    }
}