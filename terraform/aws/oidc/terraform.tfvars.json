{
    "clusters": {
        "staging": {
            "metal_dev_role": {
                "sub": "system:serviceaccount:external-secrets:external-secrets",
                "ssm_paths": [
                    "/clusters/config",
                    "/clusters/staging/*",
                    "/clusters/pgsql/staging/*"
                ]
            },
            "metal_dev_pgsql_role": {
                "sub": "system:serviceaccount:postgresql-admin:postgresql-admin",
                "ssm_paths": [
                    "/clusters/pgsql/*"
                ]
            },
            "metal_staging_role": {
                "sub": "system:serviceaccount:external-secrets:external-secrets",
                "ssm_paths": [
                    "/clusters/config",
                    "/clusters/staging/*",
                    "/clusters/pgsql/staging/*"
                ]
            },
            "metal_staging_pgsql_role": {
                "sub": "system:serviceaccount:postgresql-admin:postgresql-admin",
                "ssm_paths": [
                    "/clusters/pgsql/*"
                ]
            }
        }
    }
}