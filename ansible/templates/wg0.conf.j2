[Interface]
Address = {{ wg_address }}
ListenPort = {{ wg_port }}
PrivateKey = {{ server_privkey }}
PostUp = sysctl -w net.ipv4.ip_forward=1
PostUp = iptables -A FORWARD -i {{ wg_iface }} -o {{ uplink_bridge }} -j ACCEPT
PostUp = iptables -A FORWARD -i {{ uplink_bridge }} -o {{ wg_iface }} -m state --state RELATED,ESTABLISHED -j ACCEPT
PostDown = iptables -D FORWARD -i {{ wg_iface }} -o {{ uplink_bridge }} -j ACCEPT
PostDown = iptables -D FORWARD -i {{ uplink_bridge }} -o {{ wg_iface }} -m state --state RELATED,ESTABLISHED -j ACCEPT

[Peer]
PublicKey = {{ client_pubkey }}
AllowedIPs = {{ client_allowed_ips }}
